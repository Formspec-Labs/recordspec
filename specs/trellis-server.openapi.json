      },
      "SourceContentRoleV1": {
        "description": "Owning content family within the retained batch.",
        "enum": [
          "originalResponse",
          "correctionResponse",
          "taskProofPackage"
        ],
        "type": "string"
      },
      "SourceContentSelection": {
        "additionalProperties": false,
        "description": "Independently admitted selection, never decoded from the returned batch.",
        "properties": {
          "identity": {
            "$ref": "#/components/schemas/SourceContentIdentityV1"
          },
          "intakeCatalogSha256": {
            "items": {
              "format": "int32",
              "minimum": 0,
              "type": "integer"
            },
            "type": "array"
          },
          "nativePrefixEventHashes": {
            "description": "Complete ordered authenticated prefix before selected photos and closeout.\nIncludes independently bound WOS and Source events in their original order.\n`identity.native_prefix_digest` binds this entire prefix; the selected photo\nevents and reserved closeout follow it.",
            "items": {
              "items": {
                "format": "int32",
                "minimum": 0,
