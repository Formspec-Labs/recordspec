  },
  "servers": [
    {
      "description": "Trellis service root.",
      "url": "/"
    }
  ],
  "tags": [
    {
      "description": "Append proof-bearing events into a Trellis scope.",
      "name": "events"
    },
    {
      "description": "Read Trellis export bundles by scope and checkpoint.",
      "name": "bundles"
    },
    {
      "description": "Read registry snapshots bound into Trellis bundles.",
      "name": "registries"
    }
  ]
