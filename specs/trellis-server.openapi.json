      "SubstrateAppendBody": {
        "description": "JSON body for `POST /v1/scopes/{scope}/events`.",
        "properties": {
          "actor": {
            "$ref": "#/components/schemas/AppendActor"
          },
          "clientAttestation": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/ClientAttestation",
                "description": "Optional client attestation reserved for direct-signer flows — **omit** for\n`trellis-server` until verification is implemented (see [`ClientAttestation`])."
              },
              {
                "type": "null"
              }
            ]
          },
          "computeContext": {
            "$ref": "#/components/schemas/ComputeContext"
          },
          "eventType": {
            "description": "Admitted Trellis append literals: `wos-events` substrate registry plus Formspec appends.",
            "enum": [
              "substrate.append.response_action_session_op_batch",
              "substrate.append.response_submitted",
              "wos.ai.capability_invocation",
              "wos.assurance.identity_attestation",
              "wos.assurance.key_rebind",
              "wos.governance.amendment_authorized",
              "wos.governance.authorization_attestation",
              "wos.governance.authorization_rejected",
              "wos.governance.clock_resolved",
              "wos.governance.clock_skew_observed",
              "wos.governance.clock_started",
              "wos.governance.correction_authorized",
              "wos.governance.determination_amended",
              "wos.governance.determination_rescinded",
              "wos.governance.reinstated",
              "wos.governance.rescission_authorized",
              "wos.kernel.case_created",
              "wos.kernel.commit_attempt_failure",
              "wos.kernel.for_each_completed",
              "wos.kernel.for_each_iteration_completed",
              "wos.kernel.for_each_iteration_started",
              "wos.kernel.instance_migrated",
              "wos.kernel.intake_accepted",
              "wos.kernel.intake_deferred",
              "wos.kernel.intake_rejected",
              "wos.kernel.migration_pin_changed",
              "wos.kernel.note_added",
              "wos.kernel.signature_admission_failed",
              "wos.kernel.signature_affirmation",
              "wos.kernel.state_transition",
              "wos.provenance.recorded"
            ],
            "type": "string"
          },
          "idempotencyKey": {
            "type": "string"
          },
          "payload": {},
          "sourceContent": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/SourceContentClaim",
                "description": "Claim about the prepared Source-content batch object (ADR 0163): the object's hash and\nsize and the selection WOS derived. Trellis reads the object from its own derived key,\nso no address or credential travels. The reconcile lookup identity ignores it."
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "eventType",
          "idempotencyKey",
          "actor",
          "payload",
          "computeContext"
        ],
        "type": "object"
      },
      "SubstrateAppendResult": {
        "description": "Append response returned by the Trellis service.\n\n`checkpoint_ref` names the signed checkpoint at `sequence + 1`, durable when the response is\nsent. The Core §18 export at that checkpoint (`GET .../bundles/{checkpointDigest}`) is the\nreceipt's proof; nothing is published at append time.",
        "properties": {
          "canonicalEventHash": {
            "type": "string"
          },
          "checkpointRef": {
            "type": "string"
          },
          "eventId": {
            "type": "string"
          },
          "priorEventHash": {
            "type": [
              "string",
              "null"
            ]
          },
          "sequence": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "eventId",
          "sequence",
          "canonicalEventHash",
          "checkpointRef"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "HTTP boundary for appending events, reading Core exports assembled on request, and retrieving registry projections from the Trellis substrate service.",
    "license": {
      "name": "Apache-2.0"
    },
    "title": "Trellis Substrate API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/scopes/{scope}/accepted-attachments": {
      "post": {
        "operationId": "append",
        "parameters": [
          {
            "description": "Trellis ledger scope.",
            "in": "path",
            "name": "scope",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Opaque token; keep its exact bytes across retries of the same request.",
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "minLength": 1,
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AcceptedAttachmentAppendBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubstrateAppendResult"
                }
              }
            },
            "description": "Protected event and its checkpoint committed"
          },
          "400": {
            "description": "Invalid closed request"
          },
          "401": {
            "description": "Authentication refused"
          },
          "403": {
            "description": "Exact permission refused"
          },
          "409": {
            "description": "Replay or prefix conflict"
          },
          "503": {
            "description": "Storage or selected recipient policy unavailable"
          }
        },
        "security": [
          {
            "bearerAuth": [
              "trellis.append"
            ]
          }
        ],
        "tags": [
          "events"
        ],
        "x-access": {
          "detail": [
            "trellis.append"
          ],
          "kind": "scope"
        },
        "x-max-request-bytes": 2097152
      }
    },
    "/v1/scopes/{scope}/bundles/head": {
      "get": {
        "operationId": "getHeadBundle",
        "parameters": [
          {
            "description": "Trellis ledger scope.",
            "in": "path",
            "name": "scope",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/zip": {}
            },
            "description": "The Core section 18 export at the head checkpoint, assembled on request under Read."
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Current Read refused."
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Scope has no events."
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Stored rows or a retained Source batch contradict themselves."
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Ledger or artifact store unavailable."
          }
        },
        "security": [
          {
            "bearerAuth": [
              "trellis.read"
            ]
          }
        ],
        "tags": [
          "bundles"
        ],
        "x-access": {
          "detail": [
            "trellis.read"
          ],
          "kind": "scope"
        }
      }
    },
    "/v1/scopes/{scope}/bundles/{checkpointDigest}": {
      "get": {
        "operationId": "getBundleByCheckpointDigest",
        "parameters": [
          {
            "description": "Trellis ledger scope.",
            "in": "path",
            "name": "scope",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Checkpoint digest in `sha256:<64 hex>` form.",
            "in": "path",
            "name": "checkpointDigest",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/zip": {}
            },
            "description": "The Core section 18 export at the pinned checkpoint, assembled on request under Read."
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Invalid checkpoint digest."
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No checkpoint with that digest in the scope."
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Stored rows or a retained Source batch contradict themselves."
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Ledger or artifact store unavailable."
          }
        },
        "security": [
          {
            "bearerAuth": [
              "trellis.read"
            ]
          }
        ],
        "tags": [
          "bundles"
        ],
        "x-access": {
          "detail": [
            "trellis.read"
          ],
          "kind": "scope"
        }
      }
    },
    "/v1/scopes/{scope}/completion": {
      "post": {
        "operationId": "seal_completion",
        "parameters": [
          {
            "description": "Trellis ledger scope.",
            "in": "path",
            "name": "scope",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Opaque token; keep its exact bytes across retries of the same request.",
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "minLength": 1,
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CompletionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubstrateAppendResult"
                }
              }
            },
            "description": "Certificate and archive retained"
          },
          "400": {
            "description": "Closed trigger or selection refused, including a status or impact outside the vocabulary"
          },
          "401": {
            "description": "Current authentication refused"
          },
          "403": {
            "description": "Current permission refused, or the caller is not the configured publisher"
          },
          "409": {
            "description": "Snapshot, signing-evidence, different-principal or replay conflict"
          },
          "503": {
            "description": "Composition not selected or dependency unavailable"
          }
        },
        "security": [
          {
            "bearerAuth": [
              "trellis.append",
              "trellis.read"
            ]
          }
        ],
        "tags": [
          "events"
        ],
        "x-access": {
          "detail": [
            "trellis.append",
            "trellis.read"
          ],
          "kind": "scope"
        },
        "x-max-request-bytes": 1048576
      }
    },
    "/v1/scopes/{scope}/events": {
      "post": {
        "operationId": "appendEvent",
        "parameters": [
          {
