            },
            "type": "array"
          },
          "responseId": {
            "type": [
              "string",
              "null"
            ]
          },
          "role": {
            "$ref": "#/components/schemas/SourceContentRoleV1"
          },
          "sourcePublicationHash": {
            "items": {
              "format": "int32",
              "minimum": 0,
              "type": "integer"
            },
            "type": "array"
          }
