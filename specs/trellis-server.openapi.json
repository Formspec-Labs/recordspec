          "400": {
            "description": "Invalid lookup identity"
          },
          "401": {
            "description": "Current authentication refused"
          },
          "403": {
            "description": "Current scope read permission refused"
          }
        },
        "security": [
          {
            "bearerAuth": [
              "trellis.read"
            ]
          }
        ],
        "summary": "Looks up append identity with current read authority and no publication effects.",
        "tags": [
          "events"
        ],
        "x-access": {
          "detail": [
            "trellis.read"
          ],
          "kind": "scope"
        },
        "x-max-request-bytes": 4096
      }
