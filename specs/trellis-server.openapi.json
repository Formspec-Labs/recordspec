    "/v1/scopes/{scope}/events/reconcile": {
      "post": {
        "operationId": "reconcileEvent",
        "parameters": [
          {
            "description": "Trellis ledger scope.",
            "in": "path",
            "name": "scope",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
