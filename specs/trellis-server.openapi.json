{
  "components": {
    "schemas": {
      "AcceptedAttachmentAppendBody": {
        "additionalProperties": false,
        "description": "Original attachment and accepted descriptor sent to the protected append route.\n\nThe server selects protection, recipients and compute disclosure. The descriptor\nremains generic JSON here; the server validates its closed domain schema and\nthe authenticated caller's authority. `original_bytes` uses standard padded Base64.",
        "properties": {
          "actor": {
            "$ref": "#/components/schemas/ClosedAttachmentActor"
          },
          "descriptor": {
            "description": "Accepted Source descriptor object; serialized metadata is limited to 64 KiB and the server validates its closed domain schema.",
            "type": "object"
          },
          "idempotencyKey": {
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
          },
          "originalBytes": {
            "description": "Standard padded Base64 for one nonempty original, bounded to 1 MiB decoded.",
            "format": "byte",
            "maxLength": 1398104,
            "minLength": 4,
            "type": "string"
          }
        },
        "required": [
          "idempotencyKey",
          "actor",
          "descriptor",
          "originalBytes"
        ],
        "type": "object"
      },
      "AppendActor": {
        "description": "Actor block carried by the Trellis append wire body.",
        "properties": {
          "kind": {
            "type": "string"
          },
          "subject": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "subject"
        ],
        "type": "object"
      },
      "AppendReconciliation": {
        "description": "Read-only disposition of one original append identity.\n\nAbsence holds only at the reported read point, never for future sends. A committed event\nwithout a complete verified retained publication is unknown, not absent. JSON receipt\nfields are not an independent offline proof; consumers retain their existing proof checks.",
        "oneOf": [
          {
            "properties": {
              "receipt": {
                "$ref": "#/components/schemas/SubstrateAppendResult"
              },
              "status": {
                "enum": [
                  "committed"
                ],
                "type": "string"
              }
            },
            "required": [
              "receipt",
              "status"
            ],
            "type": "object"
          },
          {
            "properties": {
              "status": {
                "enum": [
                  "conflict"
                ],
                "type": "string"
              }
            },
            "required": [
              "status"
            ],
            "type": "object"
          },
          {
            "properties": {
              "eventCount": {
                "format": "int64",
                "minimum": 0,
                "type": "integer"
              },
              "lastEventHash": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "status": {
                "enum": [
                  "absent"
                ],
                "type": "string"
              }
            },
            "required": [
              "eventCount",
              "status"
            ],
            "type": "object"
          },
          {
            "properties": {
              "reason": {
                "$ref": "#/components/schemas/ReconciliationUnknown"
              },
              "status": {
                "enum": [
                  "unknown"
                ],
                "type": "string"
              }
            },
            "required": [
              "reason",
              "status"
            ],
            "type": "object"
          }
        ]
      },
      "AppendReconciliationRequest": {
        "additionalProperties": false,
        "description": "Exact retained identity to reconcile: an event type and idempotency key, plus either the\ncanonical payload hash or, for the completion seal, the certificate id.\n\nThe seal's payload is the HTML Trellis renders, so its caller cannot compute a content\nhash: a [`COMPLETION_EVENT`] lookup names the `certificateId` instead, and every other event\ntype names the `contentHash`. Exactly one of the two is present. Actor, compute disclosure,\nthe Source-content claim and the original HTTP body digest are not retained replay identity.",
        "properties": {
          "certificateId": {
            "type": [
              "string",
              "null"
            ]
          },
          "contentHash": {
            "items": {
              "format": "int32",
              "minimum": 0,
              "type": "integer"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "eventType": {
            "type": "string"
          },
          "idempotencyKey": {
            "type": "string"
          }
        },
        "required": [
          "eventType",
          "idempotencyKey"
        ],
        "type": "object"
      },
      "ClientAttestation": {
        "description": "Optional direct-client attestation block.\n\n**Trellis-server (2026-05-15):** Requests that include this field are rejected with\n`400`; `cose_sign1` is not cryptographically verified yet. Omit the field until\nverification lands (TWREF-0103). Durable deployments without `TRELLIS_PERMISSIVE_SCOPE_AUTH`\nuse the same HTTP admission as tests (TWREF-022 narrowing).",
        "properties": {
          "coseSign1": {
            "type": "string"
          },
          "kid": {
            "type": "string"
          }
        },
        "required": [
          "kid",
          "coseSign1"
        ],
        "type": "object"
      },
      "ClosedAttachmentActor": {
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "service"
            ],
            "type": "string"
          },
          "subject": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "subject"
        ],
        "type": "object"
      },
      "CompletionAttestor": {
        "additionalProperties": false,
        "description": "Public operator authority the owner requires to attest the certificate.",
        "properties": {
          "authority": {
            "type": "string"
          },
          "authorityClass": {
            "type": "string"
          },
          "publicKey": {
            "type": "string"
          }
        },
        "required": [
          "authority",
          "authorityClass",
          "publicKey"
        ],
        "type": "object"
      },
      "CompletionRequest": {
        "additionalProperties": false,
        "description": "Seal trigger for an exact prefix, carrying the product's selection.",
        "properties": {
          "certificateId": {
            "type": "string"
          },
          "expectedHead": {
            "type": "string"
          },
          "idempotencyKey": {
            "type": "string"
          },
          "selection": {
            "$ref": "#/components/schemas/CompletionSelection"
          },
          "signingEvents": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "idempotencyKey",
          "certificateId",
          "expectedHead",
          "signingEvents",
          "selection"
        ],
        "type": "object"
      },
      "CompletionSelection": {
        "additionalProperties": false,
        "description": "Owning facts from one current, complete, consistently read case snapshot.\n\nThe product computes this under its own permission checks and sends it in the seal\nbody. `workflow_status` describes processing disposition and does not imply approval.",
        "properties": {
          "caseRef": {
            "type": "string"
          },
          "completedAt": {
            "description": "`[unix seconds, subsecond nanoseconds]`.",
            "items": {
              "format": "int64",
              "minimum": 0,
              "type": "integer"
            },
            "type": "array"
          },
          "impactLevel": {
            "type": [
              "string",
              "null"
            ]
          },
          "requiredAttestors": {
            "items": {
              "$ref": "#/components/schemas/CompletionAttestor"
            },
            "type": "array"
          },
          "signerLabels": {
            "items": {
              "$ref": "#/components/schemas/CompletionSignerLabel"
            },
            "type": "array"
          },
          "workflowRef": {
            "type": "string"
          },
          "workflowStatus": {
            "type": "string"
          }
        },
        "required": [
          "caseRef",
          "workflowRef",
          "workflowStatus",
          "completedAt",
          "signerLabels",
          "requiredAttestors"
        ],
        "type": "object"
      },
      "CompletionSignerLabel": {
        "additionalProperties": false,
        "description": "Disclosure label for one retained signing event.",
        "properties": {
          "displayName": {
            "type": "string"
          },
          "displayRole": {
            "type": [
              "string",
              "null"
            ]
          },
          "signingEvent": {
            "type": "string"
          }
        },
        "required": [
          "signingEvent",
          "displayName"
        ],
        "type": "object"
      },
      "ComputeContext": {
        "description": "Required delegated-compute disclosure context for append producers.",
        "properties": {
          "actor": {
            "type": "string"
          },
          "declarationId": {
            "type": "string"
          },
          "sensitivity": {
            "$ref": "#/components/schemas/ComputeSensitivity"
          }
        },
        "required": [
          "declarationId",
          "actor",
          "sensitivity"
        ],
        "type": "object"
      },
      "ComputeSensitivity": {
        "description": "Sensitivity class disclosed for a producer's compute path.",
        "enum": [
          "publicMetadata",
          "providerReadable",
          "readerHeld",
          "restricted"
        ],
        "type": "string"
      },
      "ErrorCode": {
        "description": "Stable machine-readable stack error code. Prefixes are governed by ADR 0092a.\n\n <details><summary>JSON schema</summary>\n\n ```json\n{\n  \"description\": \"Stable machine-readable stack error code. Prefixes are governed by ADR 0092a.\",\n  \"examples\": [\n    \"WOS-1404\",\n    \"FORMSPEC-4001\",\n    \"STUDIO-4091\",\n    \"INFRA-5000\"\n  ],\n  \"type\": \"string\",\n  \"pattern\": \"^[A-Z]+-\\\\d{4}$\"\n}\n ```\n </details>",
        "type": "string"
      },
      "EventTypeRegistryEntry": {
        "description": "One event type in the registry projection.",
        "properties": {
          "eventType": {
            "description": "The event type literal.",
            "type": "string"
          },
          "schemaRef": {
            "description": "Reference to the schema that governs its payload.",
            "type": "string"
          }
        },
        "required": [
          "eventType",
          "schemaRef"
        ],
        "type": "object"
      },
      "EventTypeRegistryView": {
        "description": "The event-type registry projection, `GET .../registries/event-types`.",
        "properties": {
          "eventTypes": {
            "description": "Registered event types.",
            "items": {
              "$ref": "#/components/schemas/EventTypeRegistryEntry"
            },
            "type": "array"
          },
          "registryVersion": {
            "description": "Registry version.",
            "type": "string"
          }
        },
        "required": [
          "registryVersion",
          "eventTypes"
        ],
        "type": "object"
      },
      "Problem": {
        "additionalProperties": false,
        "description": "RFC 7807 problem details response with stack-generic machine code and optional context.\n\n <details><summary>JSON schema</summary>\n\n ```json\n{\n  \"description\": \"RFC 7807 problem details response with stack-generic machine code and optional context.\",\n  \"type\": \"object\",\n  \"required\": [\n    \"error_code\",\n    \"status\",\n    \"title\",\n    \"type\"\n  ],\n  \"properties\": {\n    \"context\": {\n      \"description\": \"Problem-specific diagnostic fields.\",\n      \"type\": \"object\",\n      \"additionalProperties\": true\n    },\n    \"detail\": {\n      \"description\": \"Human-readable detail specific to this occurrence.\",\n      \"examples\": [\n        \"No workflow process exists for the requested identifier.\"\n      ],\n      \"type\": \"string\",\n      \"x-wos\": {\n        \"openStringKind\": \"prose\"\n      }\n    },\n    \"error_code\": {\n      \"description\": \"Stable machine-readable stack error code.\",\n      \"examples\": [\n        \"WOS-1404\"\n      ],\n      \"$ref\": \"#/$defs/ErrorCode\"\n    },\n    \"instance\": {\n      \"description\": \"URI reference for the affected resource when a single resource caused the problem.\",\n      \"type\": \"string\",\n      \"format\": \"uri-reference\"\n    },\n    \"status\": {\n      \"description\": \"HTTP status code generated by the server for this problem.\",\n      \"examples\": [\n        404\n      ],\n      \"type\": \"integer\",\n      \"maximum\": 599.0,\n      \"minimum\": 400.0\n    },\n    \"title\": {\n      \"description\": \"Short human-readable summary of this problem type.\",\n      \"examples\": [\n        \"Resource not found\"\n      ],\n      \"type\": \"string\",\n      \"x-wos\": {\n        \"openStringKind\": \"prose\"\n      }\n    },\n    \"type\": {\n      \"description\": \"Dereferenceable URI for the documented error type.\",\n      \"examples\": [\n        \"https://schemas.formspec.io/wos-api/errors/WOS-1404\"\n      ],\n      \"type\": \"string\",\n      \"format\": \"uri-reference\"\n    }\n  },\n  \"additionalProperties\": false\n}\n ```\n </details>",
        "properties": {
          "context": {
            "additionalProperties": {},
            "description": "Problem-specific diagnostic fields.",
            "propertyNames": {
              "type": "string"
            },
            "type": "object"
          },
          "detail": {
            "description": "Human-readable detail specific to this occurrence.",
            "type": [
              "string",
              "null"
            ]
          },
          "error_code": {
            "$ref": "#/components/schemas/ErrorCode",
            "description": "Stable machine-readable stack error code."
          },
          "instance": {
            "description": "URI reference for the affected resource when a single resource caused the problem.",
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "description": "HTTP status code generated by the server for this problem.",
            "format": "int64",
            "type": "integer"
          },
          "title": {
            "description": "Short human-readable summary of this problem type.",
            "type": "string"
          },
          "type": {
            "description": "Dereferenceable URI for the documented error type.",
            "type": "string"
          }
        },
        "required": [
          "error_code",
          "status",
          "title",
          "type"
        ],
        "type": "object"
      },
      "ReconciliationUnknown": {
        "description": "Why lookup cannot establish a complete verified receipt or read point.",
        "enum": [
          "storeUnavailable",
          "receiptUnavailable",
          "verificationFailed"
        ],
        "type": "string"
      },
      "SourceContentClaim": {
        "additionalProperties": false,
        "description": "What WOS asserts about the batch object it wrote, built once at record build.\n\nEvery append attempt sends it unchanged in `SubstrateAppendBody::source_content`. The\nobject's address is not part of it: Trellis derives the key from its own tenant scope and\n`selection.preparation_key`. `hash` guards the stored bytes and `preparation_key` their meaning.",
        "properties": {
          "hash": {
            "description": "Lowercase hex SHA-256 of the exact stored object bytes.",
            "type": "string"
          },
          "selection": {
            "$ref": "#/components/schemas/SourceContentSelection"
          },
          "size": {
            "description": "Byte length of the stored object; bounds the read.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "hash",
          "size",
          "selection"
        ],
        "type": "object"
      },
      "SourceContentIdentityV1": {
        "additionalProperties": false,
        "description": "Exact native and independently selected provider identity for a committed batch.",
        "properties": {
          "caseLedgerId": {
            "type": "string"
          },
          "cellId": {
            "type": "string"
          },
          "environmentId": {
            "type": "string"
          },
          "nativePolicyHash": {
            "items": {
              "format": "int32",
              "minimum": 0,
              "type": "integer"
            },
            "type": "array"
          },
          "nativePrefixDigest": {
            "items": {
              "format": "int32",
              "minimum": 0,
              "type": "integer"
            },
            "type": "array"
          },
          "processId": {
            "type": "string"
          },
          "providerSelectionHash": {
            "items": {
              "format": "int32",
              "minimum": 0,
              "type": "integer"
            },
            "type": "array"
          },
          "recipientPolicyHash": {
            "items": {
              "format": "int32",
              "minimum": 0,
              "type": "integer"
            },
            "type": "array"
          },
          "recipientSetSha256": {
            "description": "WOS-derived digest of the canonical sorted actual recipient IDs and public keys.\n\nThis required identity field distinguishes key rotation under the same\nrecipient policy. Trellis carries and compares the owning digest; it\nneither computes the recipient-set algorithm nor grants read authority.",
            "items": {
              "format": "int32",
              "minimum": 0,
              "type": "integer"
            },
            "type": "array"
          },
          "reservedCloseoutRecordId": {
            "type": "string"
          },
          "reservedNativeCloseoutRecordSha256": {
            "items": {
              "format": "int32",
              "minimum": 0,
              "type": "integer"
            },
            "type": "array"
          },
          "serviceBindingId": {
            "type": "string"
          },
          "sourceId": {
            "type": "string"
          },
          "tenantId": {
            "type": "string"
          },
          "workflowUrl": {
            "type": "string"
          },
          "workflowVersion": {
            "type": "string"
          },
          "workspaceId": {
            "type": "string"
          }
        },
        "required": [
          "caseLedgerId",
          "processId",
          "nativePrefixDigest",
          "reservedCloseoutRecordId",
          "reservedNativeCloseoutRecordSha256",
          "providerSelectionHash",
          "nativePolicyHash",
          "recipientPolicyHash",
          "recipientSetSha256",
          "workflowUrl",
          "workflowVersion",
          "tenantId",
          "workspaceId",
          "environmentId",
          "cellId",
          "sourceId",
          "serviceBindingId"
        ],
        "type": "object"
      },
      "SourceContentRecordPins": {
        "additionalProperties": false,
        "description": "Independently admitted public identity for one protected record.",
        "properties": {
          "evaluationRegistrationHash": {
            "items": {
              "format": "int32",
              "minimum": 0,
              "type": "integer"
            },
            "type": "array"
          },
