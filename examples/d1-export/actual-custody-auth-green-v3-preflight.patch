+        malformed
+            .headers_mut()
+            .insert("content-type", content_type.parse().unwrap());
+        *malformed.body_mut() = Body::from(bytes);
+        assert_eq!(
+            app.clone().oneshot(malformed).await.unwrap().status(),
+            expected
+        );
+    }
+    assert!(repository.list_scope(b"case_123").await.unwrap().is_empty());
