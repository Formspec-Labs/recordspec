+#[test]
+fn native_provenance_json_and_cbor_share_numeric_and_depth_bounds() {
+    for number in [serde_json::json!(u64::MAX), serde_json::json!(-0.0)] {
+        let mut value = payload(); value["record"]["data"] = number;
+        assert!(NativeProvenanceEvent::from_json(&value).is_err());
+    }
+    let mut value = payload(); value["record"]["data"] = serde_json::json!([i64::MIN, i64::MAX, 1.25]);
+    assert!(NativeProvenanceEvent::from_json(&value).is_ok());
+    assert!(NativeProvenanceEvent::from_dcbor_slice(&json_to_dcbor_bytes(&value, &[]).unwrap()).is_ok());
+    let mut nested = Value::Null;
+    for _ in 0..126 { nested = Value::Array(vec![nested]); }
+    value["record"]["data"] = nested;
+    assert!(NativeProvenanceEvent::from_json(&value).is_ok());
+    assert!(NativeProvenanceEvent::from_dcbor_slice(&json_to_dcbor_bytes(&value, &[]).unwrap()).is_ok());
+    value["record"]["data"] = Value::Array(vec![value["record"]["data"].take()]);
+    assert!(NativeProvenanceEvent::from_json(&value).is_err());
+    assert!(NativeProvenanceEvent::from_dcbor_slice(&json_to_dcbor_bytes(&value, &[]).unwrap()).is_err());
+}
+
+#[test]
+fn native_provenance_refuses_duplicate_keys_before_json_conversion() {
+    let mut wrapped = json_to_cbor_value(&payload(), &[]).unwrap();
+    let CborValue::Map(fields) = &mut wrapped else { panic!("wrapper map") };
+    fields.push(fields[0].clone());
+    assert!(matches!(NativeProvenanceEvent::from_dcbor_slice(&encode_cbor_value(&wrapped).unwrap()), Err(NativeProvenanceError::InvalidCbor(_))));
+    let mut bare = json_to_cbor_value(&serde_json::to_value(record()).unwrap(), &[]).unwrap();
+    let CborValue::Map(fields) = &mut bare else { panic!("record map") };
+    let discriminator = fields.iter().find(|(key, _)| key == &CborValue::Text("recordKind".into())).unwrap().clone();
+    fields.push(discriminator);
+    assert!(matches!(NativeProvenanceEvent::from_record_dcbor_slice(&encode_cbor_value(&bare).unwrap()), Err(NativeProvenanceError::InvalidCbor(_))));
+}
+
+#[test]
+fn native_provenance_refuses_bytes_tags_and_trailing_input() {
+    for bad in [CborValue::Bytes(vec![1]), CborValue::Tag(32, Box::new(CborValue::Text("uri".into()))),
+        CborValue::Tag(0, Box::new(CborValue::Text("2026-10-09T00:00:00Z".into())))] {
+        let mut wrapped = json_to_cbor_value(&payload(), &[]).unwrap();
+        let CborValue::Map(fields) = &mut wrapped else { panic!("wrapper map") };
+        fields.push((CborValue::Text("extra".into()), bad));
+        assert!(matches!(NativeProvenanceEvent::from_dcbor_slice(&encode_cbor_value(&wrapped).unwrap()), Err(NativeProvenanceError::InvalidCbor(_))));
+    }
+    for (field, bad) in [
+        ("data", CborValue::Tag(0, Box::new(CborValue::Text("2026-10-09T00:00:00Z".into())))),
+        ("data", CborValue::Map(vec![(CborValue::Text("timestamp".into()),
+            CborValue::Tag(0, Box::new(CborValue::Text("2026-10-09T00:00:00Z".into()))))])),
+        ("timestamp", CborValue::Tag(0, Box::new(CborValue::Integer(7.into())))),
+        ("timestamp", CborValue::Tag(0, Box::new(CborValue::Tag(0,
+            Box::new(CborValue::Text("2026-10-09T00:00:00Z".into())))))),
+    ] {
+        let mut bare = json_to_cbor_value(&serde_json::to_value(record()).unwrap(), &[]).unwrap();
+        let CborValue::Map(fields) = &mut bare else { panic!("record map") };
+        let (_, value) = fields.iter_mut().find(|(key, _)| key == &CborValue::Text(field.into())).unwrap();
+        *value = bad;
+        assert!(matches!(NativeProvenanceEvent::from_record_dcbor_slice(&encode_cbor_value(&bare).unwrap()),
+            Err(NativeProvenanceError::InvalidCbor(_))));
+    }
+    let mut bytes = json_to_dcbor_bytes(&payload(), &[]).unwrap(); bytes.push(0);
+    assert!(NativeProvenanceEvent::from_dcbor_slice(&bytes).is_err());
+}
