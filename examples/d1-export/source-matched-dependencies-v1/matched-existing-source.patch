+#[test]
+fn native_provenance_refuses_missing_unknown_and_malformed_fields() {
+    let mut invalids = Vec::new();
+    for required in ["id", "recordKind", "timestamp", "auditLayer", "definitionVersion"] {
+        let mut value = payload(); value["record"].as_object_mut().unwrap().remove(required); invalids.push(value);
+    }
+    for (field, value) in [
+        ("recordKind", serde_json::json!("x-unknown")), ("recordKind", Value::Null),
+        ("id", serde_json::json!("")), ("id", serde_json::json!("arbitrary-id")),
+        ("timestamp", serde_json::json!("not-a-time")), ("timestamp", serde_json::json!("")),
+        ("auditLayer", serde_json::json!("unknown")), ("inputs", serde_json::json!([7])),
+        ("fromState", serde_json::json!({})), ("definitionVersion", serde_json::json!("")),
+        ("canonicalEventHash", serde_json::json!("invalid")),
+    ] { let mut p = payload(); p["record"][field] = value; invalids.push(p); }
+    let mut extra = payload(); extra["unexpected"] = true.into(); invalids.push(extra);
+    let mut extra = payload(); extra["record"]["unexpected"] = true.into(); invalids.push(extra);
+    invalids.extend([Value::Null, serde_json::json!({"record": []}), serde_json::json!({})]);
+    for value in invalids { assert!(NativeProvenanceEvent::from_json(&value).is_err(), "accepted {value}"); }
+}
