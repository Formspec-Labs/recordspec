+            event_type: WOS_NATIVE_PROVENANCE_EVENT_LITERAL.into(),
+            payload,
+            canonical_event_hash: [hash; 32],
+            authored_at: TrellisTimestamp {
+                seconds: 1,
+                nanos: 0,
+            },
+        }
+    }
