+        let mut cases = vec![Value::Null, json!({}), json!({"record": null})];
+        let mut extra_wrapper = valid.clone();
+        extra_wrapper["extra"] = json!(true);
+        cases.push(extra_wrapper);
+        for field in [
+            "recordKind",
+            "id",
+            "timestamp",
+            "auditLayer",
+            "definitionVersion",
