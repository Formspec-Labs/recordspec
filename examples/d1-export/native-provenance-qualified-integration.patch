+        assert_eq!(findings.len(), 1, "{findings:?}");
+        assert_eq!(findings[0].kind, "native_provenance_invalid");
+        assert_eq!(findings[0].severity, Severity::Failure);
+        assert_eq!(findings[0].event_hash, Some([3; 32]));
