+            let mut missing = valid.clone();
+            missing["record"].as_object_mut().unwrap().remove(field);
+            cases.push(missing);
+        }
+        for (field, value) in [
+            ("recordKind", json!("futureUnknownKind")),
+            ("recordKind", json!(42)),
